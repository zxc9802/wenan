# Server-side LLM configuration
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
DEFAULT_LLM_PROVIDER=gemini

# Gemini-compatible text generation provider
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://ai.shanbaob.net/v1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
GEMINI_VIDEO_API_KEY=
GEMINI_VIDEO_API_BASE_URL=
GEMINI_VIDEO_API_PROTOCOL=
GEMINI_VIDEO_MODEL=
GEMINI_VIDEO_FALLBACK_MODEL=

# DeepSeek text generation provider
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Server-side Feishu/Lark Base configuration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_IP_TABLE_ID=
FEISHU_CASES_TABLE_ID=
FEISHU_MATERIALS_TABLE_ID=
FEISHU_PERFORMANCE_TABLE_ID=

# Main-site SSO
MAIN_APP_URL=https://www.qycm.top
MAIN_APP_COPYWRITING_AGENT_ENTRY_PATH=/bot/copywriting-agent
MAIN_APP_COPYWRITING_AGENT_SSO_EXCHANGE_PATH=/api/copywriting-agent-sso/exchange
REQUIRE_MAIN_APP_SSO=true
COPYWRITING_AGENT_SESSION_SECRET=
COPYWRITING_AGENT_SESSION_COOKIE_NAME=copywriting_agent_session
COPYWRITING_AGENT_SESSION_TTL_MINUTES=720

# Zeabur/Next.js runtime port
PORT=${WEB_PORT}
